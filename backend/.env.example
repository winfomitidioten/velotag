# ==============================================================
#  velotag – Backend-Konfiguration (Vorlage)
#
#  Diese Datei nach "backend/.env" kopieren und ausfuellen:
#      copy .env.example .env      (Windows)
#      cp .env.example .env        (macOS / Linux)
#
#  Die .env selbst wird NICHT eingecheckt (siehe .gitignore).
#  Ausfuehrliche Erklaerung: siehe README.
# ==============================================================


# --- Django ---------------------------------------------------

# Neuen Key erzeugen (venv muss aktiv sein):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Den Wert in einfache Anfuehrungszeichen setzen! Generierte Keys
# enthalten haeufig ein #, ohne Quotes wuerde alles danach als
# Kommentar verschluckt und der Key waere unbrauchbar.
SECRET_KEY='hier-den-generierten-key-einfuegen'

# Einziger optionaler Wert in dieser Datei (Standard: False).
# Lokal auf True, auf dem Server auf False.
DEBUG=True


# --- Datenbank (PostgreSQL + PostGIS) -------------------------
# Diese Werte stammen 1:1 aus dem Datenbank-Setup im README:
#   CREATE DATABASE velotag;                 -> DB_NAME
#   CREATE USER velotag_dev WITH PASSWORD..  -> DB_USER / DB_PASSW

DB_NAME=velotag
DB_USER=velotag_dev
DB_PASSW=dein-datenbank-passwort
DB_HOST=localhost
DB_PORT=5432


# --- Strava OAuth 2 -------------------------------------------
# Credentials aus https://www.strava.com/settings/api
#
# WICHTIG: Der Strava-Login laeuft nur ueber den produktiven Server.
# Bei Strava ist pro App genau EINE Callback-Domain hinterlegt, und
# die zeigt auf 167.233.33.166. Ein rein lokales Backend kann den
# OAuth-Vorgang deshalb nicht abschliessen (Details im README).
# Die REDIRECT_URI daher auch lokal auf dem Produktivwert lassen.

STRAVA_CLIENT_ID=deine-client-id
STRAVA_CLIENT_SECRET=dein-client-secret
STRAVA_REDIRECT_URI=http://167.233.33.166/api/strava/callback/


# --- Optionale Werte ------------------------------------------
# Nur setzen, wenn wirklich noetig - sonst auskommentiert lassen.

# Deep-Link zurueck in die App (Standard: velotag://strava-callback)
#STRAVA_APP_REDIRECT_URL=velotag://strava-callback

# Nur noetig, wenn GDAL/GEOS NICHT in den Standardpfaden liegen
#WINDOWS_GDAL_BIN_PATH=C:\Program Files\PostgreSQL\18\bin
#MACOS_GDAL_LIB_PATH=/opt/homebrew/lib
